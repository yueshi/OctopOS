{
  "version": 1,
  "file_pattern": "^(?P<project>.+)[-_ ](?P<period>\\d{4}-W\\d{1,2}|\\d{4}-\\d{2}-\\d{2})\\.(?:xlsx|xlsm|xls|csv)$",
  "sheet": null,
  "header_row": null,
  "columns": {
    "项目": "project",
    "项目名称": "project",
    "周期": "period",
    "报告期": "period",
    "任务编号": "task_id",
    "任务ID": "task_id",
    "任务名称": "task_name",
    "任务": "task_name",
    "负责人": "owner",
    "状态": "status",
    "进度": "progress",
    "完成度": "progress",
    "优先级": "priority",
    "开始日期": "start_date",
    "截止日期": "due_date",
    "备注": "notes"
  },
  "status_map": {
    "未开始": "not_started",
    "待办": "not_started",
    "未启动": "not_started",
    "进行中": "doing",
    "处理中": "doing",
    "开发中": "doing",
    "阻塞": "blocked",
    "受阻": "blocked",
    "已完成": "done",
    "完成": "done",
    "关闭": "done"
  },
  "priority_map": {
    "低": "low",
    "中": "medium",
    "高": "high",
    "低优先级": "low",
    "中优先级": "medium",
    "高优先级": "high"
  },
  "task_id_fallback": ["project", "task_name"],
  "date_formats": ["%Y-%m-%d", "%Y/%m/%d", "%Y年%m月%d日", "%Y.%m.%d"],
  "skip_row_patterns": ["^合计", "^小计", "^总计", "^总合计", "^subtotal", "^total"],
  "pii_columns": ["身份证", "身份证号", "银行卡", "银行卡号", "手机号", "手机", "薪资", "工资"],
  "health_rules": {
    "at_risk_days": 3,
    "delayed_statuses": ["blocked"]
  },
  "default_period_type": "weekly"
}
